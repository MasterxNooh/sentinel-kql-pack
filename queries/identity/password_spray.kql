// Password spray - one IP failing against many users
// MITRE: T1110.003
SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType != "0"
| summarize FailedAttempts = count(), DistinctUsers = dcount(UserPrincipalName) by IPAddress, bin(TimeGenerated, 30m)
| where DistinctUsers > 5 and FailedAttempts > 10
| order by DistinctUsers desc
